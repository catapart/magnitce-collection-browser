{
  "name": "@magnit-ce/collection-browser",
  "version": "0.0.5",
  "description": "A custom html element that manages a collection of children as a gallery of items for interaction.",
  "main": "dist/collection-browser.umd.js",
  "module": "dist/collection-browser.js",
  "types": "dist/collection-browser.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build-tests": "vite build --config vite.config.tests.ts",
    "changeset": "npx @changesets/cli",
    "release": "npm run build && npx @changesets/cli publish"
  },
  "keywords": [
    "custom",
    "element",
    "html",
    "browser",
    "file",
    "gallery",
    "option",
    "choose"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@magnit-ce/test-runner": "^0.0.8",
    "@rollup/plugin-terser": "^1.0.0",
    "ce-part-utils": "^0.0.4",
    "changesets": "^1.0.2",
    "glob": "^13.0.0",
    "typescript": "^5.5.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "author": "catapart",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/catapart/magnitce-collection-browser"
  },
  "dependencies": {
    "@magnit-ce/selectable-items": "^0.1.4"
  }
}
